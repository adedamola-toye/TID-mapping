# ─── Wakeel Terminal Mapping Platform — environment configuration ───
# Copy to .env (never commit .env). All secrets MUST come from the environment / secret manager.

NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgres://wakeel:CHANGE_ME@localhost:5432/wakeel

# Public base URL of the application (used for CSRF origin checks and reset links)
APP_URL=http://localhost:3000

# 32-byte keys, base64 encoded. Generate with: openssl rand -base64 32
# DATA_ENCRYPTION_KEY encrypts account numbers at rest (AES-256-GCM).
# DATA_HASH_KEY keys the HMAC used for exact-match search / duplicate detection on account numbers.
# Rotating DATA_ENCRYPTION_KEY requires re-encrypting data (see docs/OPERATIONS.md).
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

# Session policy (minutes)
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_MINUTES=720

# Login protection
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# Cookie security: set to true behind HTTPS (always true in production)
SECURE_COOKIES=false

# Optional: CBN bank code (3 or 6 digits) — when set, account numbers are checked against the NUBAN check digit.
NUBAN_BANK_CODE=

# Optional override of the TID validation pattern (JavaScript regex source, uppercase input)
TID_PATTERN=^[A-Z0-9]{8}$

# Notification channels: in-app is always on. Email transport: "console" (dev only) or "none".
EMAIL_TRANSPORT=none

# Max upload size for Excel imports (bytes) and max rows per batch
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=10000

# Trust X-Forwarded-For from the reverse proxy for audit IP metadata (true only behind a trusted proxy)
TRUST_PROXY=false
